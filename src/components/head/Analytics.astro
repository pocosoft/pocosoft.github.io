---
import { site } from '../../data/site';
const enabled = import.meta.env.PROD;
---

{
  enabled && (
    <>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${site.gaId}`} />
      <script is:inline define:vars={{ id: site.gaId }}>
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          dataLayer.push(arguments);
        }
        gtag('js', new Date());
        gtag('config', id);
      </script>
    </>
  )
}
