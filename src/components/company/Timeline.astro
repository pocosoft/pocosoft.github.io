---
import { history } from '../../data/history';
const latest = history.length - 1;
---

<ol class="timeline" role="list">
  {
    history.map((h, i) => (
      <li class:list={['timeline__item', { 'is-latest': i === latest }]} data-reveal style={`--i:${i}`}>
        <time class="timeline__date" datetime={h.datetime}>
          {h.date}
        </time>
        <p class="timeline__text">{h.text}</p>
      </li>
    ))
  }
</ol>

<style>
  @layer components {
    .timeline {
      position: relative;
      display: grid;
      gap: var(--sp-6);
      padding-inline-start: var(--sp-6);
    }
    .timeline::before {
      content: '';
      position: absolute;
      inset-block: 0.6em 0.6em;
      inset-inline-start: 0.3rem;
      inline-size: 1px;
      background: linear-gradient(180deg, var(--c-line), var(--c-line-strong) 70%, var(--c-brand));
    }
    .timeline__item {
      position: relative;
      display: grid;
      gap: var(--sp-1);
    }
    .timeline__item::before {
      content: '';
      position: absolute;
      inset-inline-start: calc(var(--sp-6) * -1);
      inset-block-start: 0.5em;
      inline-size: 0.65rem;
      block-size: 0.65rem;
      border-radius: 50%;
      background: var(--c-bg);
      border: 2px solid var(--c-line-strong);
    }
    .timeline__item.is-latest::before {
      background: var(--c-brand);
      border-color: var(--c-brand);
      box-shadow: 0 0 0 0.35rem rgb(132 186 63 / 0.18);
    }
    .timeline__date {
      font-family: var(--font-mono);
      font-size: var(--fs-sm);
      color: var(--c-brand);
      letter-spacing: 0.06em;
    }
    .timeline__text {
      font-size: var(--fs-md);
    }
  }
</style>
