---
import Button from '../ui/Button.astro';
import Ja from '../ui/Ja.astro';
import AgentConsole from './AgentConsole.astro';
import { site } from '../../data/site';

const keywords = ['AI AT FULL THROTTLE', '24/7 REGRESSION TESTING', 'GAME STUDIO', 'AI QUALITY ASSURANCE', 'HUMAN IN THE LOOP', 'CONTINUOUS DELIVERY'];
---

<section class="hero" aria-labelledby="hero-title" data-hero>
  <div class="hero__world" aria-hidden="true">
    <canvas class="hero__canvas" data-hero-canvas data-running="false"></canvas>
  </div>
  <div class="hero__inner container">
    <div class="hero__head">
      <p class="hero__hud">
        <span class="hero__hud-live">RUNNING</span>
        <span class="hero__hud-clock" aria-hidden="true">DAY <b data-hud-day>001</b> <span data-hud-clock>17:16</span></span>
        <span>SLEEP <b>0</b></span>
      </p>
      <h1 id="hero-title" class="hero__title">
        <span class="hero__line"><Ja text="AIに、" /></span>
        <span class="hero__line hero__line--accent"><Ja text="休みはない。" /></span>
      </h1>
    </div>
    <div class="hero__body">
      <p class="hero__lead">
        <Ja text="我々は、AIエージェントを昼も夜も徹底的に動かし続ける開発環境をつくり、ゲームとシステムを開発しています。その環境を、あなたのチームにも。" />
      </p>
      <div class="hero__actions">
        <Button href={site.contactUrl} size="lg" external>お問い合わせ</Button>
        <Button href="#mechanism" variant="ghost" size="lg">仕組みを見る</Button>
      </div>
    </div>
    <div class="hero__console">
      <AgentConsole />
    </div>
  </div>
  <div class="hero__marquee" aria-hidden="true" data-overflow-ok>
    <div class="hero__track">
      {
        [0, 1].map(() => (
          <span class="hero__group">
            {keywords.map((k) => (
              <span class="hero__kw">
                <i />
                {k}
              </span>
            ))}
          </span>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* JS から px で読めるように、長さとして登録する */
  @property --ground-h {
    syntax: '<length>';
    inherits: true;
    initial-value: 0px;
  }
  @layer components {
    .hero {
      /* 地面の帯の高さ。ロボットが働く場所で、ウィンドウはこの上に置く */
      --ground-h: clamp(4.5rem, 12svh, 9rem);
      position: relative;
      isolation: isolate;
      min-block-size: 100svh;
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: 1fr auto;
      overflow: clip;
      background: #03060e;
    }
    .hero__world {
      grid-area: 1 / 1;
      position: relative;
      z-index: 0;
      overflow: clip;
    }
    .hero__canvas {
      position: absolute;
      inset-block-start: 0;
      inset-inline-start: 0;
      image-rendering: pixelated;
    }
    /* 状態表示（ゲームの HUD） */
    .hero__hud {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4em 1.2em;
      max-inline-size: none;
      padding: 0.6em 0.9em;
      background: #000;
      border: var(--px) solid var(--c-line-strong);
      font-family: var(--font-arcade);
      font-size: var(--fs-xs);
      line-height: 1.4;
      color: var(--c-text-muted);
    }
    .hero__hud b {
      font-weight: 400;
      color: var(--c-brand-hi);
    }
    @media (max-width: 30em) {
      .hero__hud-clock {
        display: none;
      }
    }
    /* 背の低い画面ではログを短くして、地面とロボットを最初の画面に入れる */
    @media (min-width: 48em) and (max-height: 52em) {
      .hero__console :global(.console__lines) {
        --max-lines: 4;
      }
    }
    .hero__hud-live {
      display: inline-flex;
      align-items: center;
      gap: 0.5em;
      color: var(--c-brand-hi);
    }
    .hero__hud-live::before {
      content: '';
      inline-size: 0.6em;
      block-size: 0.6em;
      background: var(--c-brand);
    }
    @media (prefers-reduced-motion: no-preference) {
      .hero__hud-live::before {
        animation: hud-blink 1s steps(1) infinite;
      }
    }
    @keyframes hud-blink {
      50% {
        opacity: 0;
      }
    }
    .hero__inner {
      grid-area: 1 / 1;
      position: relative;
      z-index: 1;
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      align-content: space-between;
      gap: var(--sp-6);
      /* 下はロボットの背丈（約 14 ドット）ぶん空けて、ウィンドウで隠さない */
      padding-block: calc(var(--header-h) + var(--sp-6)) calc(var(--ground-h) + max(6vw, 3rem));
      grid-template-areas: 'head' 'body' 'console';
    }
    .hero__head {
      grid-area: head;
      display: grid;
      justify-items: start;
      gap: var(--sp-5);
    }
    .hero__title {
      /* 見出しが短いので大きく。ただし画面の高さにも合わせ、地面とロボットが最初の画面に入るようにする。
         黒い縁取りで、どの時間帯の空の上でも読める */
      font-size: clamp(2.75rem, min(1rem + 8vw, 12.5svh), 9rem);
      line-height: 1.15;
      letter-spacing: 0.02em;
      font-weight: 400;
      --o: calc(var(--px) * 2);
      text-shadow:
        var(--o) 0 0 #000,
        calc(var(--o) * -1) 0 0 #000,
        0 var(--o) 0 #000,
        0 calc(var(--o) * -1) 0 #000,
        var(--o) var(--o) 0 #000,
        calc(var(--o) * -1) var(--o) 0 #000,
        var(--o) calc(var(--o) * -1) 0 #000,
        calc(var(--o) * -1) calc(var(--o) * -1) 0 #000,
        calc(var(--o) * 2) calc(var(--o) * 2) 0 #000;
    }
    .hero__line {
      display: block;
    }
    .hero__line--accent {
      color: var(--c-brand-hi);
    }
    /* RPG の会話ウィンドウ */
    .hero__body {
      grid-area: body;
      position: relative;
      align-self: end;
      display: grid;
      gap: var(--sp-5);
      padding: clamp(var(--sp-4), 0.75rem + 1.5vw, var(--sp-6));
      border-style: solid;
      border-width: calc(var(--px) * 3);
      border-image: var(--frame) 3 / calc(var(--px) * 3) / 0 stretch;
      background: var(--c-win);
      background-clip: padding-box;
    }
    .hero__lead {
      font-size: var(--fs-lg);
      line-height: 1.8;
      color: var(--c-text);
      max-inline-size: 30em;
      word-break: keep-all;
      overflow-wrap: anywhere;
    }
    .hero__actions {
      display: flex;
      flex-wrap: wrap;
      gap: var(--sp-4);
    }
    .hero__console {
      grid-area: console;
      align-self: end;
    }
    /* スマホでは、ロボットが働く地面を最初の画面に入れるためログを隠す */
    @media (max-width: 47.99em) {
      .hero__console {
        display: none;
      }
    }
    @media (min-width: 64em) {
      .hero__inner {
        grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
        grid-template-areas: 'head head' 'body console';
        column-gap: var(--sp-6);
        row-gap: var(--sp-5);
      }
      .hero__lead {
        font-size: var(--fs-md);
      }
    }

    .hero__marquee {
      grid-row: 2;
      position: relative;
      z-index: 1;
      border-block: var(--px) solid #000;
      background: #000;
      overflow: clip;
      font-family: var(--font-arcade);
      font-size: var(--fs-xs);
      color: var(--c-text-subtle);
    }
    .hero__track {
      display: flex;
      inline-size: max-content;
    }
    .hero__group {
      display: flex;
      flex: none;
    }
    .hero__kw {
      display: inline-flex;
      align-items: center;
      gap: 1.2em;
      padding: var(--sp-3) 1.2em;
      white-space: nowrap;
      line-height: 1.6;
    }
    .hero__kw i {
      inline-size: 0.5em;
      block-size: 0.5em;
      background: var(--c-brand);
    }
    @media (prefers-reduced-motion: no-preference) {
      .hero__track {
        animation: marquee 48s steps(480) infinite;
      }
    }
    @keyframes marquee {
      to {
        translate: -50% 0;
      }
    }
  }
</style>

<script>
  import { createPixelWorld } from '../../scripts/hero/pixel-world';
  import { createConsole } from '../../scripts/hero/console';
  import { consoleLines } from '../../data/console-lines';
  import { reducedMotion, watchVisibility } from '../../scripts/env';

  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const canvas = hero?.querySelector<HTMLCanvasElement>('[data-hero-canvas]');
  const consoleEl = hero?.querySelector<HTMLElement>('[data-agent-console]');
  const hudDay = hero?.querySelector<HTMLElement>('[data-hud-day]');
  const hudClock = hero?.querySelector<HTMLElement>('[data-hud-clock]');

  if (hero && canvas && consoleEl) {
    const saveData = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection?.saveData === true;
    const animate = !reducedMotion() && !saveData;
    // 世界はすぐに描く（最初の1枚が LCP の背景になるため、遅らせない）
    const world = createPixelWorld(canvas, {
      animate,
      onClock: (day, hh, mm) => {
        if (hudDay) hudDay.textContent = String(day).padStart(3, '0');
        if (hudClock) hudClock.textContent = `${String(hh).padStart(2, '0')}:${String(mm).padStart(2, '0')}`;
      },
    });
    const agentConsole = createConsole(consoleEl, consoleLines);

    if (animate) {
      let inView = true;
      const sync = () => {
        if (inView && !document.hidden) {
          world.start();
          agentConsole.start();
        } else {
          world.stop();
          agentConsole.stop();
        }
      };
      watchVisibility(hero, (v) => {
        inView = v;
        sync();
      });
      document.addEventListener('visibilitychange', sync);
    }
  }
</script>
